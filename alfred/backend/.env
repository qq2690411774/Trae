# alfred_ Execution Decision Layer - API Key Configuration
# Copy this file to .env and fill in your API keys.
# At least one key is required for LLM-powered decisions.
# Without keys, the system falls back to deterministic rules.

# OpenAI (GPT-4o-mini)
OPENAI_API_KEY=

# ZhipuAI (GLM-5.1, GLM-5V-Turbo)
ZHIPU_API_KEY=
